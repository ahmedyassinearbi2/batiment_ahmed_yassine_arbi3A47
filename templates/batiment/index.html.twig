{% extends 'base.html.twig' %}

{% block title %}Liste des Bâtiments{% endblock %}

{% block body %}
<h1>Liste des Bâtiments</h1>

<a href="{{ path('batiment_add') }}" class="btn btn-success mb-3">Ajouter un bâtiment</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Nombre d’étages</th>
            <th>Date de construction</th>
            <th>Disponibilité</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for batiment in batiments %}
            <tr>
                <td>{{ batiment.id }}</td>
                <td>{{ batiment.nom }}</td>
                <td>{{ batiment.nbretage }}</td>
                <td>{{ batiment.dateconst ? batiment.dateconst|date('Y-m-d') : '' }}</td>
                <td>{{ batiment.disponible }}</td>
                <td>
                    <a href="{{ path('batiment_edit', {'id': batiment.id}) }}" class="btn btn-primary btn-sm">Modifier</a>
                    <a href="{{ path('batiment_delete', {'id': batiment.id}) }}" class="btn btn-danger btn-sm">Supprimer</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center">Aucun bâtiment trouvé</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
